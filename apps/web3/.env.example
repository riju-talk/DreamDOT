# apps/web3 — minimal on-chain transaction ledger

PORT=3005
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5000

# MUST match apps/web's SERVICE_SECRET exactly (internal x-service-secret auth).
SERVICE_SECRET=

# Same Mongo connection as the rest of the platform — stores every LedgerEntry.
MONGODB_URI=

# ---------------------------------------------------------------------------
# On-chain writes are OPTIONAL. Leave these blank to run in "local-only" mode
# (LedgerEntry rows are still written to Mongo, txHash is null).
#
# Default target = Polygon Amoy testnet:
#   1. Create a burner wallet (MetaMask, or `node -e "console.log(require('viem/accounts').generatePrivateKey())"`)
#   2. Fund it with free test POL: https://faucet.polygon.technology  (select "Amoy")
#   3. Paste the private key below.
# ---------------------------------------------------------------------------
CHAIN_ID=80002
CHAIN_NAME=polygon-amoy
RPC_URL=https://rpc-amoy.polygon.technology
WEB3_PRIVATE_KEY=
EXPLORER_BASE=https://amoy.polygonscan.com
