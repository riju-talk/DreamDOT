# apps/chat — copy to apps/chat/.env (local) or set as platform secrets.

PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Same Mongo as the rest of the platform (DMs + channel messages).
MONGODB_URI=mongodb://localhost:27017/dreamdot

# Postgres — community schema (read-only membership checks + presence writes).
POSTGRESS_DB_COMMUNITY=postgresql://postgres:postgres@localhost:5433/dreamdot?schema=community

# MUST match apps/web exactly.
JWT_SECRET=
SERVICE_SECRET=

# Where to POST notification events (apps/notifications).
NOTIFICATIONS_SERVICE_URL=http://localhost:3003

# Comma-separated allowed origins.
CORS_ORIGIN=http://localhost:5000,http://localhost:3000
SOCKET_PATH=/socket.io
