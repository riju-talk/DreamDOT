# apps/notifications — reuses env vars already defined for the rest of the platform.
# No new secrets, no new database. Copy the real values from the repo root .env / apps/web/.env.

PORT=3003
HOST=0.0.0.0

# Same Postgres connection as apps/web's social schema — this service reads/writes the
# `notifications` table that already lives there.
POSTGRESS_DB_SOCIAL=

# Same Mongo connection as every other service — used only to read User.notifications.types{}
# preference toggles before writing a notification.
MONGODB_URI=

# Same signing secret NextAuth issues tokens with — must match apps/web and apps/chat exactly.
JWT_SECRET=

# Same shared secret other internal services already use to call each other server-to-server.
SERVICE_SECRET=

CORS_ORIGIN=http://localhost:5000
SOCKET_PATH=/socket.io
