{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "chat:dev": "cd apps/chat && npm run dev",
    "chat:build": "cd apps/chat && npm run build",
    "chat:start": "cd apps/chat && npm start",
    "dev:all": "concurrently \"npm run dev\" \"npm run chat:dev\"",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:logs": "docker-compose logs -f",
    "db:seed": "tsx scripts/seed.ts",
    "db:clear": "tsx scripts/seed.ts --clear"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "5.9.2",
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.8.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@swc/helpers": "^0.5.17",
    "bcryptjs": "^3.0.3",
    "@faker-js/faker": "^8.4.1",
    "dotenv": "^16.3.1",
    "mongoose": "^8.9.5",
    "uuid": "^9.0.1",
    "mongodb": "^6.3.0"
  }
}
